# Frontend (Vite) — safe to expose in the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase CLI — set locally for `supabase login` alternative (never commit)
# Generate at: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Edge Function secrets — set in Supabase Dashboard or via `supabase secrets set`
# Never use these in the React app or commit real values.

# sms.ir OTP delivery (send-sms Edge Function)
# SMS_IR_API_KEY=
# SMS_IR_TEMPLATE_ID=
# SMS_IR_OTP_PARAM_NAME=Code
# Shared with Auth → Hooks → Send SMS. Format: v1,whsec_<base64>
# SEND_SMS_HOOK_SECRET=

# Arvan Cloud object storage (Phase 5)
# ARVAN_ACCESS_KEY=
# ARVAN_SECRET_KEY=
# ARVAN_PRIVATE_BUCKET=
# ARVAN_PUBLIC_BUCKET=edu-consult-web
# ARVAN_ENDPOINT=

# Public exam-analysis media (permanent URLs, safe for the browser)
# VITE_PUBLIC_STORAGE_BASE_URL=https://edu-consult-web.s3.ir-thr-at1.arvanstorage.ir

# SUPABASE_SERVICE_ROLE_KEY=
